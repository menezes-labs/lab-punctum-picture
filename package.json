{
  "name": "punctum-picture",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "preview": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start": "npm run preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern node_modules.partial",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply punctum-picture --local",
    "db:migrate:remote": "wrangler d1 migrations apply punctum-picture --remote",
    "db:seed": "wrangler d1 execute punctum-picture --local --file migrations/0002_seed_settings.sql",
    "backup:d1": "wrangler d1 export punctum-picture --remote --output ./backups/database.sql",
    "restore:d1": "wrangler d1 execute punctum-picture --remote --file ./backups/database.sql"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/hashes": "2.4.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.28",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "magic-string": "^0.30.17",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "type": "module"
}
